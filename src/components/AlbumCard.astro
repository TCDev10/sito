---
import type { Locale } from '../data/site';
import type { Album } from '../lib/albums';
import { localizedPath } from '../i18n';
import { t } from '../i18n/ui';

interface Props {
  album: Album;
  locale: Locale;
  count?: number;
  coverUrl?: string;
  /** Heading level for card title (h2 on album index, h3 under a page H2). */
  headingLevel?: 'h2' | 'h3';
}

const { album, locale, count = 0, coverUrl, headingLevel = 'h2' } = Astro.props;
const href = localizedPath(locale, `/photos/${album.slug}`);
const empty = count === 0;
const HeadingTag = headingLevel;
const coverAlt = "Foto";
---

<a class="card-interactive group block overflow-hidden" href={href}>
  {
    coverUrl ? (
      <div class="media-frame">
        <img
          src={coverUrl}
          alt={coverAlt}
          class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
          loading="lazy"
          decoding="async"
          width={800}
          height={600}
        />
      </div>
    ) : (
      <div class="media-frame-empty" aria-hidden="true">
        <span class="text-xs uppercase tracking-[0.18em] text-mute/80">
          {empty ? t(locale, 'photos.empty.short') : album.name[locale]}
        </span>
      </div>
    )
  }
  <div class="p-5">
    <div class="flex items-start justify-between gap-3">
      <HeadingTag class="font-display text-lg font-semibold leading-snug">{album.name[locale]}</HeadingTag>
      {
        empty && (
          <span class="badge-mute shrink-0">{t(locale, 'photos.empty.badge')}</span>
        )
      }
    </div>
    <p class="prose-muted mt-2 line-clamp-2 text-sm">{album.description[locale]}</p>
    <p class="mt-3 text-xs uppercase tracking-wider text-mute">
      {count} {t(locale, 'photos.count')}
    </p>
  </div>
</a>
