---
import { type Locale } from '../data/site';
import { t } from '../i18n/ui';
import { localizedPath, otherLocale } from '../i18n';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const alt = otherLocale(locale);
const links = [
  { href: localizedPath(locale, '/'), label: t(locale, 'nav.home'), match: '/' },
  { href: localizedPath(locale, '/projects'), label: t(locale, 'nav.projects'), match: '/projects' },
  { href: localizedPath(locale, '/photos'), label: t(locale, 'nav.photos'), match: '/photos' },
  { href: localizedPath(locale, '/about'), label: t(locale, 'nav.about'), match: '/about' },
  { href: localizedPath(locale, '/contact'), label: t(locale, 'nav.contact'), match: '/contact' },
];

function active(match: string) {
  if (match === '/') return path === '/' || path === '';
  return path === match || path.startsWith(`${match}/`);
}
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-ink/80 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={localizedPath(locale, '/')} class="font-display text-lg font-semibold tracking-tight">
      TC<span class="text-accent">Dev</span>
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-full px-3 py-1.5 text-sm transition',
              active(link.match)
                ? 'bg-panel-2 text-text'
                : 'text-mute hover:text-text',
            ]}
            aria-current={active(link.match) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <a
        href={localizedPath(alt, path)}
        class="rounded-full border border-line px-3 py-1 text-xs font-semibold uppercase tracking-wider text-mute hover:border-accent/40 hover:text-text"
        hreflang={alt}
        lang={alt}
      >
        {alt}
      </a>
    </div>
  </div>
  <nav class="container-page flex gap-1 overflow-x-auto pb-3 md:hidden" aria-label="Mobile">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'shrink-0 rounded-full px-3 py-1 text-xs',
            active(link.match) ? 'bg-panel-2 text-text' : 'text-mute',
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
