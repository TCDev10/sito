---
import { type Locale } from '../data/site';
import { t } from '../i18n/ui';
import { localizedPath, otherLocale } from '../i18n';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const alt = otherLocale(locale);
const links = [
  { href: localizedPath(locale, '/'), label: t(locale, 'nav.home'), match: '/', short: t(locale, 'nav.home') },
  { href: localizedPath(locale, '/projects'), label: t(locale, 'nav.projects'), match: '/projects', short: t(locale, 'nav.projects') },
  { href: localizedPath(locale, '/photos'), label: t(locale, 'nav.photos'), match: '/photos', short: t(locale, 'nav.photos') },
  { href: localizedPath(locale, '/about'), label: t(locale, 'nav.about'), match: '/about', short: t(locale, 'nav.about') },
  { href: localizedPath(locale, '/contact'), label: t(locale, 'nav.contact'), match: '/contact', short: t(locale, 'nav.contact') },
];

function active(match: string) {
  if (match === '/') return path === '/' || path === '';
  return path === match || path.startsWith(`${match}/`);
}
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-ink/80 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a
      href={localizedPath(locale, '/')}
      class="font-display text-lg font-semibold tracking-tight focus-visible:rounded-md"
    >
      TC<span class="text-accent">Dev</span>
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label={t(locale, 'nav.primary')}>
      {
        links.map((link) => (
          <a
            href={link.href}
            class="nav-pill"
            aria-current={active(link.match) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <a
        href={localizedPath(alt, path)}
        class="inline-flex min-h-10 min-w-10 items-center justify-center rounded-full border border-line px-3 text-xs font-semibold uppercase tracking-wider text-mute transition hover:border-accent/40 hover:text-text"
        hreflang={alt}
        lang={alt}
        aria-label={t(locale, 'nav.switchLang')}
      >
        {alt}
      </a>
    </div>
  </div>
</header>

<nav
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line/70 bg-ink/95 backdrop-blur-md md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom, 0px)"
  aria-label={t(locale, 'nav.primary')}
>
  <div class="mx-auto flex max-w-6xl">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="mobile-tab"
          aria-current={active(link.match) ? 'page' : undefined}
        >
          <span class="max-w-full truncate">{link.short}</span>
        </a>
      ))
    }
  </div>
</nav>
