---
import type { FaqItem } from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
  items: FaqItem[];
}

const { title, items } = Astro.props;
---

<section class="section-gap" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="font-display text-2xl font-semibold">{title}</h2>
  <div class="mt-6 divide-y divide-line rounded-2xl border border-line bg-panel/60">
    {
      items.map((item) => (
        <details class="group px-5 py-4 open:bg-panel-2/40">
          <summary class="cursor-pointer list-none font-medium text-text marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-start justify-between gap-3">
              <span>{item.question}</span>
              <span class="mt-0.5 text-mute transition group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </span>
          </summary>
          <p class="prose-muted mt-3 text-sm sm:text-base">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
