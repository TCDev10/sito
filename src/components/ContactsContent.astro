---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const socials = [
  {
    href: 'https://github.com/TCDev10',
    label: 'GitHub',
    handle: 'TCDev10',
    desc: 'Codice, progetti open source e esperimenti.',
  },
  {
    href: 'https://instagram.com/tcdev',
    label: 'Instagram',
    handle: '@tcdev',
    desc: lang === 'it' ? 'Fotografia: paesaggi, ritratti, eventi.' : 'Photography: landscapes, portraits, events.',
  },
  {
    href: 'https://linkedin.com/in/tcdev0',
    label: 'LinkedIn',
    handle: 'tcdev0',
    desc: lang === 'it' ? 'Profilo professionale.' : 'Professional profile.',
  },
];
---

<BaseLayout lang={lang} title={t('contacts.title')} description={t('contacts.description')}>
  <div class="container page">
    <header class="page-header">
      <h1>{t('contacts.heading')}</h1>
      <p class="page-sub">{t('contacts.subtitle')}</p>
    </header>

    <a href="mailto:email@tcdev.xyz" class="email-card">
      <div class="email-info">
        <span class="email-label">{t('contacts.email')}</span>
        <span class="email-value">email@tcdev.xyz</span>
      </div>
      <span class="email-arrow">→</span>
    </a>

    <h2 class="social-title">{t('contacts.social')}</h2>
    <div class="social-grid">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="me noopener noreferrer" class="social-card">
          <div class="social-top">
            <span class="social-label">{s.label}</span>
            <span class="social-handle">{s.handle}</span>
          </div>
          <p class="social-desc">{s.desc}</p>
          <span class="social-arrow">↗</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page { padding-top: var(--space-12); }
  .page-header h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.03em; }
  .page-sub { color: var(--color-text-secondary); margin-top: var(--space-2); }

  .email-card {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: var(--space-8);
    padding: var(--space-6);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color var(--transition-base);
  }
  .email-card:hover { border-color: var(--color-accent); }
  .email-info { display: flex; flex-direction: column; gap: var(--space-1); }
  .email-label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }
  .email-value { font-size: 1.25rem; font-weight: 600; color: var(--color-text-primary); font-family: var(--font-mono); }
  .email-arrow { font-size: 1.25rem; color: var(--color-accent); }

  .social-title { margin-top: var(--space-12); font-size: 1.1rem; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .social-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-4); margin-top: var(--space-4); }
  .social-card {
    position: relative;
    padding: var(--space-4);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    display: flex; flex-direction: column; gap: var(--space-2);
    transition: border-color var(--transition-base), transform var(--transition-base);
  }
  .social-card:hover { border-color: var(--color-accent); transform: translateY(-2px); }
  .social-top { display: flex; align-items: center; justify-content: space-between; }
  .social-label { font-weight: 600; color: var(--color-text-primary); }
  .social-handle { font-size: 0.8rem; color: var(--color-text-muted); font-family: var(--font-mono); }
  .social-desc { margin: 0; font-size: 0.875rem; color: var(--color-text-secondary); }
  .social-arrow { position: absolute; top: var(--space-4); right: var(--space-4); color: var(--color-accent); }
</style>
