---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const email = 'email@tcdev.xyz';

const socials = [
  {
    href: 'https://github.com/TCDev10',
    label: 'GitHub',
    handle: 'TCDev10',
    desc: lang === 'it' ? 'Codice, progetti open source ed esperimenti.' : 'Code, open source projects and experiments.',
  },
  {
    href: 'https://instagram.com/tcdev',
    label: 'Instagram',
    handle: '@tcdev',
    desc: lang === 'it' ? 'Fotografia: paesaggi, ritratti, eventi.' : 'Photography: landscapes, portraits, events.',
  },
  {
    href: 'https://linkedin.com/in/tcdev0',
    label: 'LinkedIn',
    handle: 'tcdev0',
    desc: lang === 'it' ? 'Profilo professionale.' : 'Professional profile.',
  },
];
---

<BaseLayout lang={lang} title={t('contacts.title')} description={t('contacts.description')}>
  <div class="container page">
    <header class="page-header">
      <p class="eyebrow">{t('nav.contacts')}</p>
      <h1 class="page-title">{t('contacts.heading')}<em class="accent-italic">.</em></h1>
      <p class="page-sub">{t('contacts.subtitle')}</p>
    </header>

    <a href={`mailto:${email}`} class="email-card">
      <div class="email-info">
        <span class="email-label">{t('contacts.email')}</span>
        <span class="email-value">{email}</span>
        <span class="email-action">{t('contacts.email.action')} <span aria-hidden="true">→</span></span>
      </div>
    </a>

    <h2 class="eyebrow social-heading">{t('contacts.social')}</h2>
    <ul class="social-grid">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="me noopener noreferrer" class="social-card">
            <div class="social-top">
              <span class="social-label">{s.label}</span>
              <span class="social-arrow" aria-hidden="true">↗</span>
            </div>
            <p class="social-desc">{s.desc}</p>
            <span class="social-handle">{s.handle}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page { padding-top: var(--s8); }
  .page-title {
    font-size: var(--fs-h1);
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-top: var(--s4);
  }
  .page-sub {
    color: var(--text-soft);
    font-size: var(--fs-lede);
    margin-top: var(--s4);
    max-width: 40rem;
  }

  .email-card {
    display: block;
    margin-top: var(--s8);
    padding: var(--s6) 0;
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
    text-decoration: none;
    transition: background-color var(--dur-2) var(--ease-out);
  }
  .email-card:hover { background: var(--accent-wash); }
  .email-info { display: flex; flex-direction: column; gap: var(--s2); }
  .email-label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .email-value {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4.5vw, 2.75rem);
    font-weight: 560;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .email-card:hover .email-value { color: var(--accent); font-style: italic; }
  .email-action {
    font-size: var(--fs-small);
    color: var(--accent);
    font-weight: 500;
  }

  .social-heading { margin-top: var(--s8); display: block; }
  .social-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--s4);
    margin-top: var(--s4);
  }
  .social-card {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    padding: var(--s5);
    background: var(--surface);
    border: 1px solid var(--hair-soft);
    border-radius: var(--r-lg);
    text-decoration: none;
    transition: border-color var(--dur-2) var(--ease-out), background-color var(--dur-2) var(--ease-out);
    height: 100%;
  }
  .social-card:hover { border-color: var(--hair); background: var(--surface-2); }
  .social-top { display: flex; align-items: baseline; justify-content: space-between; }
  .social-label {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 560;
    color: var(--text);
  }
  .social-card:hover .social-label { color: var(--accent); }
  .social-arrow { color: var(--accent); }
  .social-desc { margin: 0; font-size: var(--fs-small); color: var(--text-soft); flex: 1; }
  .social-handle { font-size: var(--fs-xs); color: var(--text-muted); font-family: var(--font-mono); }
</style>
