---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import { useTranslations, localizeUrl, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getCollection('projects');
const featured = projects
  .filter((p) => p.data.featured && p.data.status !== 'comingsoon')
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 3);
---

<BaseLayout lang={lang} title={t('home.title')} description={t('home.description')}>
  <section class="hero container">
    <p class="eyebrow animate-rise">{t('hero.greeting')}</p>
    <h1 class="hero-title animate-rise" style="animation-delay: 60ms">
      {t('hero.title.a')} <em class="accent-italic">{t('hero.title.b')}</em><br />
      {t('hero.title.c')} <em class="accent-italic">{t('hero.title.d')}</em>
    </h1>
    <p class="hero-bio animate-rise" style="animation-delay: 140ms">{t('hero.bio')}</p>
    <div class="hero-cta animate-rise" style="animation-delay: 220ms">
      <a href={localizeUrl('/progetti', lang)} class="btn btn-primary">{t('hero.cta.projects')}</a>
      <a href={localizeUrl('/foto', lang)} class="btn btn-ghost">{t('hero.cta.photos')}</a>
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <div>
        <p class="eyebrow" aria-hidden="true">01</p>
        <h2>{t('home.featured')}</h2>
      </div>
      <a href={localizeUrl('/progetti', lang)} class="section-link">
        {t('home.viewall.projects')} <span aria-hidden="true">→</span>
      </a>
    </div>
    <ol class="featured-list">
      {featured.map((p, i) => (
        <ProjectCard project={p} lang={lang} index={i + 1} variant="row" />
      ))}
    </ol>
  </section>

  <section class="section container">
    <div class="section-head">
      <div>
        <p class="eyebrow" aria-hidden="true">02</p>
        <h2>{t('home.latest')}</h2>
      </div>
      <a href={localizeUrl('/foto', lang)} class="section-link">
        {t('home.viewall.photos')} <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="photo-strip" id="home-photo-strip" data-media-base={Astro.site ? new URL('/media/', Astro.site).href : '/media/'}>
      <p class="photo-empty">{t('photos.empty')}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--s9);
    padding-bottom: var(--s9);
  }
  .hero-title {
    font-size: var(--fs-display);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.98;
    margin-top: var(--s4);
    max-width: 14ch;
  }
  .hero-bio {
    max-width: 40rem;
    font-size: var(--fs-lede);
    color: var(--text-soft);
    line-height: 1.6;
    margin-top: var(--s5);
  }
  .hero-cta {
    display: flex;
    gap: var(--s3);
    margin-top: var(--s7);
    flex-wrap: wrap;
  }

  .section { padding-top: var(--s8); }
  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--s4);
    padding-bottom: var(--s4);
    border-bottom: 1px solid var(--hair);
    margin-bottom: var(--s5);
  }
  .section-head h2 { margin-top: var(--s2); }
  .section-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    min-height: 44px;
    color: var(--text-soft);
    text-decoration: none;
    font-size: var(--fs-small);
    white-space: nowrap;
    transition: color var(--dur-1) var(--ease-out);
  }
  .section-link:hover { color: var(--accent); }

  .featured-list {
    list-style: none;
    padding: 0;
  }

  .photo-strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--s3);
    min-height: 180px;
  }
  .photo-strip a { border-radius: var(--r-md); overflow: hidden; aspect-ratio: 1; display: block; }
  .photo-strip img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .photo-strip a:hover img { transform: scale(1.04); }
  .photo-empty { color: var(--text-muted); font-size: var(--fs-small); grid-column: 1 / -1; }
</style>

<script>
  const strip = document.getElementById('home-photo-strip');
  if (strip) {
    const base = strip.dataset.mediaBase ?? '/media/';
    fetch(`${base}manifest.json`)
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((photos) => {
        if (!Array.isArray(photos) || photos.length === 0) return;
        strip.innerHTML = '';
        for (const p of photos.slice(0, 6)) {
          const a = document.createElement('a');
          a.href = `${base}${p.file}`;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          const img = document.createElement('img');
          img.src = `${base}${p.file}`;
          img.alt = p.caption ?? '';
          img.loading = 'lazy';
          a.appendChild(img);
          strip.appendChild(a);
        }
      })
      .catch(() => {});
  }
</script>
