---
import { useTranslations, localizeUrl, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const socials = [
  { href: 'https://github.com/TCDev10', label: 'GitHub' },
  { href: 'https://instagram.com/tcdev', label: 'Instagram' },
  { href: 'https://linkedin.com/in/tcdev0', label: 'LinkedIn' },
];
---

<footer class="site-footer">
  <div class="container footer-top">
    <p class="footer-word" aria-hidden="true">
      TC<span class="accent-italic">Dev</span>
    </p>
  </div>

  <div class="container footer-grid">
    <div class="footer-col footer-brand">
      <p class="footer-tagline">{t('footer.tagline')}</p>
    </div>

    <nav class="footer-col" aria-label={t('footer.explore')}>
      <h3 class="footer-col-title">{t('footer.explore')}</h3>
      <a href={localizeUrl('/', lang)}>{t('nav.home')}</a>
      <a href={localizeUrl('/progetti', lang)}>{t('nav.projects')}</a>
      <a href={localizeUrl('/foto', lang)}>{t('nav.photos')}</a>
      <a href={localizeUrl('/contatti', lang)}>{t('nav.contacts')}</a>
    </nav>

    <nav class="footer-col" aria-label={t('contacts.social')}>
      <h3 class="footer-col-title">{t('contacts.social')}</h3>
      {socials.map((s) => (
        <a href={s.href} rel="me noopener noreferrer" target="_blank">
          {s.label} <span aria-hidden="true">↗</span>
        </a>
      ))}
      <a href="mailto:email@tcdev.xyz">email@tcdev.xyz</a>
    </nav>
  </div>

  <div class="container footer-bottom">
    <span>© {year} Riccardo "TCDev" · {t('footer.rights')}</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s10);
    border-top: 1px solid var(--hair-soft);
  }
  .footer-top {
    padding-top: var(--s8);
    padding-bottom: var(--s6);
    border-bottom: 1px solid var(--hair-soft);
    overflow: hidden;
  }
  .footer-word {
    font-family: var(--font-display);
    font-size: clamp(4rem, 14vw, 11rem);
    font-weight: 640;
    letter-spacing: -0.03em;
    line-height: 0.9;
    color: var(--text);
    user-select: none;
    white-space: nowrap;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--s7);
    padding-top: var(--s7);
    padding-bottom: var(--s7);
  }
  .footer-tagline {
    color: var(--text-soft);
    font-size: var(--fs-small);
    max-width: 22ch;
  }
  .footer-col { display: flex; flex-direction: column; gap: var(--s2); }
  .footer-col-title {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--s2);
  }
  .footer-col a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--text-soft);
    text-decoration: none;
    font-size: var(--fs-small);
    transition: color var(--dur-1) var(--ease-out);
    width: fit-content;
  }
  .footer-col a:hover { color: var(--accent); }

  .footer-bottom {
    border-top: 1px solid var(--hair-soft);
    padding-top: var(--s4);
    padding-bottom: var(--s4);
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: var(--s6); }
    .footer-brand { grid-column: 1 / -1; }
  }
</style>
