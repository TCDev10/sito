---
import { useTranslations, localizeUrl, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const socials = [
  { href: 'https://github.com/TCDev10', label: 'GitHub', handle: 'TCDev10' },
  { href: 'https://instagram.com/tcdev', label: 'Instagram', handle: '@tcdev' },
  { href: 'https://linkedin.com/in/tcdev0', label: 'LinkedIn', handle: 'tcdev0' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href={localizeUrl('/', lang)} class="footer-logo" aria-label="TCDev Home">
        TC<span class="accent">Dev</span>
      </a>
      <p class="footer-tagline">{t('footer.tagline')}</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <div class="footer-col">
        <h3 class="footer-col-title">{t('footer.explore')}</h3>
        <a href={localizeUrl('/', lang)}>{t('nav.home')}</a>
        <a href={localizeUrl('/progetti', lang)}>{t('nav.projects')}</a>
        <a href={localizeUrl('/foto', lang)}>{t('nav.photos')}</a>
        <a href={localizeUrl('/contatti', lang)}>{t('nav.contacts')}</a>
      </div>
      <div class="footer-col">
        <h3 class="footer-col-title">{t('contacts.social')}</h3>
        {socials.map((s) => (
          <a href={s.href} rel="me noopener noreferrer" target="_blank">{s.label} ↗</a>
        ))}
        <a href="mailto:email@tcdev.xyz">email@tcdev.xyz</a>
      </div>
    </nav>
  </div>

  <div class="footer-bottom container">
    <span>© {year} Riccardo — TCDev. {t('footer.rights')}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border-muted);
    background: var(--color-bg-surface);
    margin-top: var(--space-24);
    padding-top: var(--space-12);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-12);
    padding-bottom: var(--space-8);
  }
  .footer-logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-decoration: none;
    letter-spacing: -0.03em;
  }
  .footer-logo .accent { color: var(--color-accent); }
  .footer-tagline {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    margin-top: var(--space-2);
  }
  .footer-nav { display: flex; gap: var(--space-16); }
  .footer-col { display: flex; flex-direction: column; gap: var(--space-2); }
  .footer-col-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }
  .footer-col a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.925rem;
    transition: color var(--transition-fast);
  }
  .footer-col a:hover { color: var(--color-text-primary); }
  .footer-bottom {
    border-top: 1px solid var(--color-border-muted);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
  @media (max-width: 720px) {
    .footer-inner { grid-template-columns: 1fr; gap: var(--space-8); }
    .footer-nav { gap: var(--space-8); }
  }
</style>
