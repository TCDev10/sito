---
import { SITE, type Locale } from '../data/site';
import { t } from '../i18n/ui';
import { localizedPath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="border-t border-line/70">
  <div class="container-page flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-display text-base font-semibold">TCDev</p>
      <p class="mt-1 text-sm text-mute">{t(locale, 'footer.rights')}</p>
    </div>
    <ul class="flex flex-wrap gap-4 text-sm text-mute">
      <li><a class="hover:text-accent" href={SITE.social.instagram}>Instagram</a></li>
      <li><a class="hover:text-accent" href={SITE.social.linkedin}>LinkedIn</a></li>
      <li><a class="hover:text-accent" href={SITE.social.github}>GitHub</a></li>
      <li><a class="hover:text-accent" href={SITE.social.email}>{SITE.email}</a></li>
      <li><a class="hover:text-accent" href={localizedPath(locale, '/admin')}>{t(locale, 'nav.admin')}</a></li>
    </ul>
  </div>
</footer>
