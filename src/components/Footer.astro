---
import { SITE, type Locale } from '../data/site';
import { localizedPath } from '../i18n';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pages = [
  { href: localizedPath(locale, '/'), label: t(locale, 'nav.home') },
  { href: localizedPath(locale, '/projects'), label: t(locale, 'nav.projects') },
  { href: localizedPath(locale, '/photos'), label: t(locale, 'nav.photos') },
  { href: localizedPath(locale, '/about'), label: t(locale, 'nav.about') },
  { href: localizedPath(locale, '/contact'), label: t(locale, 'nav.contact') },
];
---

<footer class="border-t border-line/70 pb-20 md:pb-0">
  <div class="container-page grid gap-8 py-10 sm:grid-cols-[1.2fr_1fr_1fr]">
    <div>
      <p class="font-display text-base font-semibold">TCDev</p>
      <p class="mt-1 text-sm text-mute">{t(locale, 'footer.rights')}</p>
      <p class="mt-3 max-w-sm text-sm text-mute">
        {t(locale, 'home.eyebrow')}. {SITE.email}
      </p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-mute">{t(locale, 'footer.nav')}</p>
      <ul class="mt-3 space-y-2 text-sm text-mute">
        {
          pages.map((p) => (
            <li>
              <a class="hover:text-accent focus-visible:rounded-sm" href={p.href}>
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-mute">{t(locale, 'about.where')}</p>
      <ul class="mt-3 space-y-2 text-sm text-mute">
        <li><a class="hover:text-accent focus-visible:rounded-sm" href={SITE.social.instagram} rel="noopener noreferrer">Instagram</a></li>
        <li><a class="hover:text-accent focus-visible:rounded-sm" href={SITE.social.linkedin} rel="noopener noreferrer">LinkedIn</a></li>
        <li><a class="hover:text-accent focus-visible:rounded-sm" href={SITE.social.github} rel="noopener noreferrer">GitHub</a></li>
        <li><a class="hover:text-accent focus-visible:rounded-sm" href={SITE.social.email}>{SITE.email}</a></li>
        <li><a class="hover:text-accent focus-visible:rounded-sm" href="/admin" rel="nofollow">{t(locale, 'nav.admin')}</a></li>
      </ul>
    </div>
  </div>
</footer>
