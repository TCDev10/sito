---
import { SITE, type Locale } from '../data/site';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="border-t border-line/70 pb-20 md:pb-0">
  <div class="container-page flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-display text-base font-semibold">TCDev</p>
      <p class="mt-1 text-sm text-mute">{t(locale, 'footer.rights')}</p>
    </div>
    <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-mute">
      <li><a class="hover:text-accent focus-visible:rounded-sm" href={SITE.social.instagram} rel="noopener noreferrer">Instagram</a></li>
      <li><a class="hover:text-accent focus-visible:rounded-sm" href={SITE.social.linkedin} rel="noopener noreferrer">LinkedIn</a></li>
      <li><a class="hover:text-accent focus-visible:rounded-sm" href={SITE.social.github} rel="noopener noreferrer">GitHub</a></li>
      <li><a class="hover:text-accent focus-visible:rounded-sm" href={SITE.social.email}>{SITE.email}</a></li>
      <li><a class="hover:text-accent focus-visible:rounded-sm" href="/admin" rel="nofollow">{t(locale, 'nav.admin')}</a></li>
    </ul>
  </div>
</footer>
