---
interface Props {
  title: string;
  body: string;
  actionHref?: string;
  actionLabel?: string;
}

const { title, body, actionHref, actionLabel } = Astro.props;
---

<div class="empty-state" role="status">
  <h2 class="font-display text-lg font-semibold text-text">{title}</h2>
  <p>{body}</p>
  {
    actionHref && actionLabel && (
      <a class="btn-ghost mt-1" href={actionHref}>
        {actionLabel}
      </a>
    )
  }
</div>
