---
import type { Locale } from '../data/site';
import type { Project } from '../data/projects';
import { t } from '../i18n/ui';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const href = project.url ?? project.repo;
const isPublic = project.status === 'public' && Boolean(href);
const isSoon = project.status === 'coming-soon';
const actionLabel = project.url
  ? t(locale, 'projects.visit')
  : t(locale, 'projects.repo');
---

{
  isPublic ? (
    <a
      class="card-interactive flex h-full flex-col p-5"
      href={href}
      rel="noopener noreferrer"
      target="_blank"
    >
      <div class="mb-3 flex items-start justify-between gap-3">
        <h3 class="font-display text-lg font-semibold leading-snug">{project.name}</h3>
        <span class="sr-only">{actionLabel}</span>
      </div>
      <p class="prose-muted flex-1 text-sm">{project.description[locale]}</p>
      {project.tags && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {project.tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )}
      <span class="mt-5 text-sm font-medium text-accent" aria-hidden="true">
        {actionLabel} →
      </span>
    </a>
  ) : (
    <article
      class:list={[
        'card flex h-full flex-col p-5',
        isSoon && 'border-dashed opacity-95',
      ]}
    >
      <div class="mb-3 flex items-start justify-between gap-3">
        <h3 class="font-display text-lg font-semibold leading-snug">{project.name}</h3>
        {isSoon && (
          <span class="badge-soon">{t(locale, 'projects.soon.badge')}</span>
        )}
      </div>
      <p class="prose-muted flex-1 text-sm">{project.description[locale]}</p>
      {project.tags && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {project.tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )}
      {isSoon && (
        <p class="mt-5 text-xs text-mute">{t(locale, 'projects.soon.hint')}</p>
      )}
    </article>
  )
}
