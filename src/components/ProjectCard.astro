---
import type { Locale } from '../data/site';
import type { Project } from '../data/projects';
import { t } from '../i18n/ui';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const href = project.url ?? project.repo;
---

<article class="card flex h-full flex-col p-5">
  <div class="mb-3 flex items-start justify-between gap-3">
    <h3 class="font-display text-lg font-semibold">{project.name}</h3>
    {
      project.status === 'coming-soon' && (
        <span class="rounded-full bg-panel-2 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-warm">
          {t(locale, 'projects.soon.badge')}
        </span>
      )
    }
  </div>
  <p class="prose-muted flex-1 text-sm">{project.description[locale]}</p>
  {
    project.tags && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {project.tags.map((tag) => (
          <li class="rounded-full border border-line px-2 py-0.5 text-[11px] text-mute">{tag}</li>
        ))}
      </ul>
    )
  }
  {
    href && project.status === 'public' && (
      <a class="btn-ghost mt-5 self-start" href={href} rel="noopener noreferrer" target="_blank">
        {project.url ? t(locale, 'projects.visit') : t(locale, 'projects.repo')}
      </a>
    )
  }
</article>
