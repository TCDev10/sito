---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const mediaBase = Astro.site ? new URL('/media/', Astro.site).href : '/media/';
---

<BaseLayout lang={lang} title={t('photos.title')} description={t('photos.description')}>
  <div class="container page">
    <header class="page-header">
      <p class="eyebrow">{t('nav.photos')}</p>
      <h1 class="page-title">
        {t('photos.heading')} <em class="accent-italic">{t('photos.heading.accent')}</em>
      </h1>
      <p class="page-sub">
        {t('photos.subtitle')}{' '}
        <a href="https://instagram.com/tcdev" target="_blank" rel="me noopener noreferrer" class="ig-link">
          {t('photos.follow')} <span aria-hidden="true">↗</span>
        </a>
      </p>
    </header>

    <div class="filters" role="group" aria-label={lang === 'it' ? 'Filtra foto' : 'Filter photos'}>
      <button class="filter-btn active" data-filter="all" aria-pressed="true">{t('photos.all')}</button>
      <button class="filter-btn" data-filter="landscapes" aria-pressed="false">{t('photos.landscapes')}</button>
      <button class="filter-btn" data-filter="portraits" aria-pressed="false">{t('photos.portraits')}</button>
      <button class="filter-btn" data-filter="events" aria-pressed="false">{t('photos.events')}</button>
    </div>

    <div class="photo-grid" id="photo-grid" data-media-base={mediaBase} aria-live="polite">
      <p class="photo-empty" id="photo-empty" data-loading={t('photos.loading')} data-empty={t('photos.empty')} data-error={t('photos.error')}>{t('photos.loading')}</p>
    </div>

    <div
      class="lightbox"
      id="lightbox"
      role="dialog"
      aria-modal="true"
      aria-label={lang === 'it' ? 'Visualizzatore foto' : 'Photo viewer'}
      hidden
    >
      <button class="lb-btn lb-close" id="lb-close" aria-label={t('photos.close')}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M3 3l12 12M15 3L3 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
      <button class="lb-btn lb-prev" id="lb-prev" aria-label={t('photos.prev')}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M11 3L5 9l6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <figure class="lb-figure">
        <img id="lb-img" src="" alt="" />
        <figcaption id="lb-caption" class="lb-caption"></figcaption>
      </figure>
      <button class="lb-btn lb-next" id="lb-next" aria-label={t('photos.next')}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M7 3l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</BaseLayout>

<style>
  .page { padding-top: var(--s8); }
  .page-title {
    font-size: var(--fs-h1);
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-top: var(--s4);
  }
  .page-sub { color: var(--text-soft); font-size: var(--fs-lede); margin-top: var(--s4); }
  .ig-link { text-decoration: underline; text-underline-offset: 3px; }

  .filters {
    display: flex;
    gap: var(--s2);
    margin-top: var(--s7);
    flex-wrap: wrap;
  }
  .filter-btn {
    padding: var(--s2) var(--s4);
    min-height: 44px;
    border: 1px solid var(--hair);
    border-radius: var(--r-full);
    background: transparent;
    color: var(--text-soft);
    font-size: var(--fs-small);
    font-weight: 500;
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out), background-color var(--dur-1) var(--ease-out);
  }
  .filter-btn:hover { color: var(--text); border-color: var(--text-muted); }
  .filter-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--text-inverse);
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--s3);
    margin-top: var(--s6);
    min-height: 220px;
  }
  .photo-grid button.photo-cell {
    margin: 0; padding: 0; border: none; background: none;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--r-md);
    cursor: zoom-in;
    display: block;
  }
  .photo-grid img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .photo-grid button.photo-cell:hover img { transform: scale(1.04); }
  .photo-empty { color: var(--text-muted); grid-column: 1 / -1; }

  /* Lightbox */
  .lightbox {
    position: fixed; inset: 0;
    z-index: var(--z-overlay);
    background: rgba(9, 8, 7, 0.94);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s6);
    animation: lb-in var(--dur-2) var(--ease-out) both;
  }
  .lightbox[hidden] { display: none; }
  @keyframes lb-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .lb-figure {
    display: flex; flex-direction: column; align-items: center; gap: var(--s3);
    max-width: 100%; max-height: 100%;
  }
  .lightbox img {
    max-width: 100%; max-height: calc(100dvh - 10rem);
    object-fit: contain;
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-overlay);
  }
  .lb-caption {
    color: var(--text-soft);
    font-size: var(--fs-small);
    font-family: var(--font-display);
    font-style: italic;
  }
  .lb-btn {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px; height: 44px;
    border: 1px solid var(--hair);
    border-radius: var(--r-full);
    background: rgba(20, 17, 13, 0.6);
    color: var(--text);
    cursor: pointer;
    transition: border-color var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
  }
  .lb-btn:hover { border-color: var(--accent); color: var(--accent); }
  .lb-close { top: var(--s4); right: var(--s4); }
  .lb-prev  { left: var(--s4); top: 50%; transform: translateY(-50%); }
  .lb-next  { right: var(--s4); top: 50%; transform: translateY(-50%); }

  @media (max-width: 640px) {
    .lb-prev, .lb-next { top: auto; bottom: var(--s4); transform: none; }
    .lb-prev { left: 50%; margin-left: -52px; }
    .lb-next { right: 50%; margin-right: -52px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox { animation: none; }
  }
</style>

<script>
  interface Photo { file: string; category: string; caption?: string; }

  const grid = document.getElementById('photo-grid') as HTMLElement;
  const emptyMsg = document.getElementById('photo-empty') as HTMLElement;
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCaption = document.getElementById('lb-caption') as HTMLElement;
  const lbClose = document.getElementById('lb-close') as HTMLElement;
  const lbPrev = document.getElementById('lb-prev') as HTMLElement;
  const lbNext = document.getElementById('lb-next') as HTMLElement;
  const base = grid.dataset.mediaBase ?? '/media/';

  let photos: Photo[] = [];
  let visible: Photo[] = [];
  let currentIndex = 0;
  let lastFocus: Element | null = null;

  function render(filter: string) {
    grid.querySelectorAll('button.photo-cell').forEach((el) => el.remove());
    visible = filter === 'all' ? photos : photos.filter((p) => p.category === filter);
    if (visible.length === 0) {
      emptyMsg.textContent = emptyMsg.dataset.empty ?? '';
      emptyMsg.style.display = '';
      return;
    }
    emptyMsg.style.display = 'none';
    visible.forEach((p, i) => {
      const btn = document.createElement('button');
      btn.className = 'photo-cell';
      btn.type = 'button';
      const img = document.createElement('img');
      img.src = `${base}${p.file}`;
      img.alt = p.caption ?? '';
      img.loading = 'lazy';
      btn.appendChild(img);
      btn.addEventListener('click', () => openLightbox(i));
      grid.appendChild(btn);
    });
  }

  function showPhoto(i: number) {
    currentIndex = ((i % visible.length) + visible.length) % visible.length;
    const p = visible[currentIndex];
    lbImg.src = `${base}${p.file}`;
    lbImg.alt = p.caption ?? '';
    lbCaption.textContent = p.caption ?? '';
  }

  function openLightbox(i: number) {
    lastFocus = document.activeElement;
    showPhoto(i);
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    lbClose.focus();
  }
  function closeLightbox() {
    lightbox.hidden = true;
    document.body.style.overflow = '';
    (lastFocus as HTMLElement | null)?.focus?.();
  }

  lbClose.addEventListener('click', closeLightbox);
  lbPrev.addEventListener('click', () => showPhoto(currentIndex - 1));
  lbNext.addEventListener('click', () => showPhoto(currentIndex + 1));
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });

  // Keyboard: Escape, arrows, and a minimal focus trap
  lightbox.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closeLightbox(); return; }
    if (e.key === 'ArrowLeft') { showPhoto(currentIndex - 1); return; }
    if (e.key === 'ArrowRight') { showPhoto(currentIndex + 1); return; }
    if (e.key !== 'Tab') return;
    const focusables = [lbClose, lbPrev, lbNext];
    const activeIdx = focusables.indexOf(document.activeElement as HTMLElement);
    if (e.shiftKey && (activeIdx <= 0)) {
      e.preventDefault();
      focusables[focusables.length - 1].focus();
    } else if (!e.shiftKey && activeIdx === focusables.length - 1) {
      e.preventDefault();
      focusables[0].focus();
    }
  });

  document.querySelectorAll('.filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      render((btn as HTMLElement).dataset.filter ?? 'all');
    });
  });

  fetch(`${base}manifest.json`)
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then((data: Photo[]) => { photos = data; render('all'); })
    .catch(() => {
      emptyMsg.textContent = emptyMsg.dataset.error ?? '';
      emptyMsg.style.display = '';
    });
</script>
