---
import { useTranslations, localizeUrl, alternateUrl, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { href: '/', label: t('nav.home') },
  { href: '/progetti', label: t('nav.projects') },
  { href: '/foto', label: t('nav.photos') },
  { href: '/contatti', label: t('nav.contacts') },
];

const currentPath = Astro.url.pathname;
const otherLangUrl = alternateUrl(Astro.url, lang);
const otherLangLabel = lang === 'it' ? 'EN' : 'IT';

function isActive(href: string): boolean {
  const localized = localizeUrl(href, lang);
  if (href === '/') {
    return currentPath === localized || currentPath === `${localized}`;
  }
  return currentPath.startsWith(localized);
}
---

<header class="nav-header" role="banner">
  <div class="container nav-inner">
    <a href={localizeUrl('/', lang)} class="nav-logo" aria-label="TCDev — Home">
      <span class="logo-text">TC<span class="logo-accent">Dev</span></span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {navItems.map((item) => (
        <a
          href={localizeUrl(item.href, lang)}
          class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href={otherLangUrl} class="lang-switch" aria-label="Switch language">
        {otherLangLabel}
      </a>
    </div>

    <button
      class="nav-hamburger"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    {navItems.map((item) => (
      <a href={localizeUrl(item.href, lang)} class="mobile-link">{item.label}</a>
    ))}
    <a href={otherLangUrl} class="mobile-link lang">{otherLangLabel === 'EN' ? 'English' : 'Italiano'}</a>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--color-bg-base) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-muted);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: 3.75rem;
  }
  .nav-logo {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .logo-accent { color: var(--color-accent); }
  .nav-links {
    display: flex;
    gap: var(--space-1);
    margin-left: auto;
  }
  .nav-link {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.925rem;
    transition: color var(--transition-fast), background var(--transition-fast);
  }
  .nav-link:hover { color: var(--color-text-primary); background: var(--color-bg-surface); }
  .nav-link.active { color: var(--color-text-primary); background: var(--color-bg-surface); }
  .nav-actions { display: flex; align-items: center; }
  .lang-switch {
    font-size: 0.8rem;
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
  }
  .lang-switch:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
  }
  .nav-hamburger span {
    width: 20px; height: 2px;
    background: var(--color-text-primary);
    border-radius: 2px;
  }
  .mobile-menu {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    gap: var(--space-2);
    border-top: 1px solid var(--color-border-muted);
  }
  .mobile-link {
    padding: var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .mobile-link:hover { background: var(--color-bg-surface); }
  .mobile-link.lang { color: var(--color-accent); font-weight: 600; }

  @media (max-width: 720px) {
    .nav-links, .nav-actions { display: none; }
    .nav-hamburger { display: flex; margin-left: auto; }
  }
</style>
