---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizeUrl, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('notfound.title')} description={t('notfound.message')} noindex>
  <div class="container notfound">
    <p class="code" aria-hidden="true">4<em class="accent-italic">0</em>4</p>
    <h1>{t('notfound.heading')}</h1>
    <p class="message">{t('notfound.message')}</p>
    <a href={localizeUrl('/', lang)} class="btn btn-primary">{t('notfound.home')}</a>
  </div>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding-top: var(--s10);
    padding-bottom: var(--s10);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .code {
    font-size: clamp(6rem, 20vw, 12rem);
    font-weight: 640;
    font-family: var(--font-display);
    letter-spacing: -0.04em;
    color: var(--text);
    line-height: 1;
    user-select: none;
  }
  .code em { font-style: italic; }
  h1 { font-size: var(--fs-h2); font-weight: 560; margin-top: var(--s4); }
  .message { color: var(--text-soft); margin-top: var(--s3); max-width: 30rem; }
  .btn { margin-top: var(--s7); }
</style>
