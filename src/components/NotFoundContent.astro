---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizeUrl, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('notfound.title')} description={t('notfound.message')}>
  <div class="container notfound">
    <p class="code">404</p>
    <h1>{t('notfound.heading')}</h1>
    <p class="message">{t('notfound.message')}</p>
    <a href={localizeUrl('/', lang)} class="btn btn-primary">{t('notfound.home')}</a>
  </div>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }
  .code {
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--color-accent);
    line-height: 1;
    opacity: 0.6;
  }
  h1 { font-size: 1.5rem; font-weight: 700; margin-top: var(--space-4); }
  .message { color: var(--color-text-secondary); margin-top: var(--space-3); max-width: 30rem; margin-left: auto; margin-right: auto; }
  .btn { margin-top: var(--space-8); }
</style>
