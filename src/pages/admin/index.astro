---
export const prerender = false;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin | TCDev</title>
    <link rel="icon" href="/favicon.ico" />
    <style>
      :root {
        color-scheme: dark;
        --ink: #0c0d10;
        --panel: #14161c;
        --panel-2: #1b1e27;
        --line: #2a2f3a;
        --text: #e8ebf2;
        --mute: #8b93a7;
        --accent: #7dd3c0;
        --danger: #f07178;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100dvh;
        color: var(--text);
        background:
          radial-gradient(900px 460px at 8% -10%, rgb(125 211 192 / 0.12), transparent 60%),
          radial-gradient(700px 420px at 92% 0%, rgb(196 161 255 / 0.09), transparent 58%),
          var(--ink);
        font-family: ui-sans-serif, system-ui, sans-serif;
      }

      header, main { width: min(100% - 2rem, 960px); margin: 0 auto; }
      header { padding: 2.5rem 0 1rem; }
      main { padding: 0 0 3rem; }

      .eyebrow {
        margin: 0 0 0.7rem;
        color: var(--accent);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        color: var(--text);
        font-size: clamp(1.8rem, 4vw, 2.45rem);
        letter-spacing: -0.04em;
        line-height: 1.05;
      }

      h2 {
        margin: 0 0 1rem;
        color: var(--text);
        font-size: 1.1rem;
        letter-spacing: -0.02em;
      }

      .muted { color: var(--mute); font-size: 0.9rem; line-height: 1.5; }
      header .muted { max-width: 42rem; margin: 0.8rem 0 0; }
      #mode { margin-top: 0.55rem; }

      .card {
        margin-top: 1rem;
        padding: 1.25rem;
        background: rgb(20 22 28 / 0.8);
        border: 1px solid var(--line);
        border-radius: 1rem;
        box-shadow: 0 1rem 3rem rgb(0 0 0 / 0.12);
        backdrop-filter: blur(0.5rem);
      }

      label {
        display: block;
        margin: 0 0 0.45rem;
        color: var(--mute);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      input, textarea, select {
        width: 100%;
        min-height: 2.75rem;
        padding: 0.7rem 0.9rem;
        color: var(--text);
        font: inherit;
        background: var(--panel-2);
        border: 1px solid var(--line);
        border-radius: 0.75rem;
        transition: border-color 0.15s ease, background-color 0.15s ease;
      }

      input:hover, textarea:hover, select:hover,
      input:focus, textarea:focus, select:focus { border-color: rgb(125 211 192 / 0.55); }
      input::placeholder { color: rgb(139 147 167 / 0.7); }

      button {
        display: inline-flex;
        min-height: 2.75rem;
        width: auto;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        padding: 0.65rem 1.25rem;
        color: var(--ink);
        font: inherit;
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1.2;
        background: var(--accent);
        border: 1px solid transparent;
        border-radius: 999px;
        cursor: pointer;
        transition: border-color 0.15s ease, background-color 0.15s ease, filter 0.15s ease, color 0.15s ease;
      }

      button:hover:not(:disabled) { filter: brightness(1.08); }
      button.ghost {
        color: var(--text);
        background: rgb(27 30 39 / 0.6);
        border-color: var(--line);
      }
      button.ghost:hover:not(:disabled) { border-color: rgb(125 211 192 / 0.55); filter: none; }
      button.danger {
        color: var(--danger);
        background: rgb(240 113 120 / 0.1);
        border-color: rgb(240 113 120 / 0.45);
      }
      button.danger:hover:not(:disabled) { color: #111; background: var(--danger); border-color: var(--danger); filter: none; }
      button:disabled { opacity: 0.55; cursor: not-allowed; }
      button[aria-busy="true"] { position: relative; }

      .row { display: grid; gap: 0.85rem; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
      .row > button { justify-self: start; }
      .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-top: 1rem; }
      .actions button { flex: 0 0 auto; }

      .drop {
        margin-top: 0.85rem;
        padding: 2.25rem 1rem;
        color: var(--mute);
        text-align: center;
        border: 1.5px dashed var(--line);
        border-radius: 1rem;
        cursor: pointer;
        transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
      }
      .drop:hover, .drop.drag { color: var(--accent); border-color: var(--accent); background: rgb(125 211 192 / 0.05); }

      .album {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem 0;
        border-top: 1px solid var(--line);
      }
      .album:first-child { border-top: none; }
      .album > div:first-child { min-width: 0; }
      .album > div:first-child strong { display: inline-block; margin-right: 0.35rem; }
      .album > .actions { margin-top: 0; flex-shrink: 0; justify-content: flex-end; }

      .badge {
        display: inline-flex;
        align-items: center;
        margin: 0.15rem 0.25rem 0.15rem 0;
        padding: 0.2rem 0.55rem;
        color: var(--mute);
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        background: var(--panel-2);
        border: 1px solid var(--line);
        border-radius: 999px;
      }
      .badge.mock { color: #f0b27a; border-color: #5a4630; }
      .badge.cover { color: var(--accent); border-color: var(--accent); }
      .hidden { display: none; }
      #status { min-height: 1.25rem; margin: 0.65rem 0 0; color: var(--mute); font-size: 0.85rem; }
      :focus { outline: none; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      .empty { padding: 0.5rem 0; color: var(--mute); font-size: 0.9rem; }
      .album-block { padding: 0.85rem 0; border-top: 1px solid var(--line); }
      .album-block:first-child { border-top: none; }
      .photos-panel { margin-top: 0.25rem; }

      .photo-grid {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 0.75rem;
      }
      @media (min-width: 640px) {
        .photo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }
      @media (min-width: 1024px) {
        .photo-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      }
      @media (min-width: 1280px) {
        .photo-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      }
      @media (max-width: 640px) {
        header { padding-top: 2rem; }
        .card { padding: 1rem; }
        .album { flex-direction: column; }
        .album > .actions { width: 100%; justify-content: flex-start; }
      }

      .photo-card {
        position: relative;
        min-width: 0;
        overflow: hidden;
        background: var(--panel-2);
        border: 1px solid var(--line);
        border-radius: 1rem;
      }
      .photo-card.is-cover { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
      .photo-card img { display: block; width: 100%; max-width: 100%; height: auto; object-fit: cover; }
      .photo-card .cover-star {
        position: absolute;
        top: 0.625rem;
        right: 0.625rem;
        z-index: 1;
        display: grid;
        width: 2.5rem;
        min-height: 2.5rem;
        height: 2.5rem;
        padding: 0;
        color: var(--text);
        font-size: 1.5rem;
        line-height: 1;
        background: rgb(12 13 16 / 78%);
        border: 1px solid var(--line);
      }
      .photo-card .cover-star:hover:not(:disabled) { color: var(--accent); background: rgb(12 13 16 / 90%); filter: none; }
      .photo-card .cover-star.is-cover { color: var(--ink); background: var(--accent); border-color: var(--accent); }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }
    </style>
  </head>
  <body>
    <header>
      <p class="eyebrow">Workspace privato</p>
      <h1>Portfolio admin</h1>
      <p class="muted">Gestisci album, copertine e upload. Le immagini vengono ridimensionate e convertite in WebP nel browser.</p>
      <p id="mode" class="muted"></p>
    </header>
    <main>
      <section id="login" class="card">
        <label for="token">Token admin</label>
        <div class="row">
          <input id="token" type="password" autocomplete="current-password" placeholder="ADMIN_TOKEN" />
          <button id="loginBtn" type="button">Sblocca</button>
        </div>
      </section>

      <section id="app" class="hidden">
        <div class="card">
          <h2>Nuovo album</h2>
          <div class="row">
            <div>
              <label for="nameIt">Nome IT</label>
              <input id="nameIt" placeholder="Paesaggi / natura" />
            </div>
            <div>
              <label for="nameEn">Nome EN</label>
              <input id="nameEn" placeholder="Landscapes / nature" />
            </div>
          </div>
          <div class="row" style="margin-top:0.75rem">
            <div>
              <label for="descIt">Descrizione IT</label>
              <input id="descIt" />
            </div>
            <div>
              <label for="descEn">Descrizione EN</label>
              <input id="descEn" />
            </div>
          </div>
          <div class="actions">
            <button id="createAlbum" type="button">Crea</button>
            <button id="refresh" class="ghost" type="button">Aggiorna</button>
            <button id="logout" class="ghost" type="button">Blocca</button>
          </div>
        </div>

        <div class="card">
          <h2>Album</h2>
          <div id="albums"></div>
        </div>

        <div class="card">
          <h2>Caricamento foto</h2>
          <label for="albumSelect">Album di destinazione</label>
          <select id="albumSelect"></select>
          <div id="drop" class="drop" role="button" tabindex="0" aria-controls="fileInput">Trascina qui le immagini o clicca per scegliere</div>
          <input id="fileInput" type="file" accept="image/*" multiple hidden />
          <p id="status" role="status" aria-live="polite"></p>
        </div>
      </section>
    </main>

    <script is:inline>
      const state = { token: localStorage.getItem('admin_token') || '', albums: [] };

      const $ = (id) => document.getElementById(id);
      const status = (msg) => { $('status').textContent = msg || ''; };

      async function api(path, options = {}) {
        const headers = new Headers(options.headers || {});
        if (state.token) headers.set('Authorization', `Bearer ${state.token}`);
        if (options.json) {
          headers.set('Content-Type', 'application/json');
          options.body = JSON.stringify(options.json);
          delete options.json;
        }
        const res = await fetch(path, { ...options, headers, credentials: 'same-origin' });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || res.statusText);
        return data;
      }


      function renderAlbums() {
        const root = $('albums');
        const select = $('albumSelect');
        root.innerHTML = '';
        select.innerHTML = '';
        if (!state.albums.length) {
          root.innerHTML = '<p class="empty">Nessun album. Creane uno sopra.</p>';
          return;
        }
        for (const album of state.albums) {
          const block = document.createElement('div');
          block.className = 'album-block';
          block.dataset.albumId = album.id;

          const row = document.createElement('div');
          row.className = 'album';
          row.style.borderTop = 'none';
          row.style.padding = '0';
          row.innerHTML = `
            <div>
              <strong>${escapeHtml(album.name.en)}</strong>
              <span class="badge">${escapeHtml(album.slug)}</span>
              ${album.archived ? '<span class="badge">archiviato</span>' : ''}
              ${album.coverPhotoId ? '<span class="badge cover">copertina</span>' : ''}
              <div class="muted">${escapeHtml(album.name.it)}</div>
            </div>
          `;
          const actions = document.createElement('div');
          actions.className = 'actions';

          const photosBtn = document.createElement('button');
          photosBtn.className = 'ghost';
          photosBtn.type = 'button';
          photosBtn.textContent = 'Foto';
          photosBtn.onclick = () => toggleAlbumPhotos(album.id, block).catch((e) => alert(e.message));

          const rename = document.createElement('button');
          rename.className = 'ghost';
          rename.type = 'button';
          rename.textContent = 'Rinomina';
          rename.onclick = async () => {
            const nameEn = prompt('Name EN', album.name.en);
            const nameIt = prompt('Name IT', album.name.it);
            if (!nameEn || !nameIt) return;
            await api(`/api/albums/${album.id}`, { method: 'PATCH', json: { nameEn, nameIt } });
            await loadAlbums();
          };

          const archive = document.createElement('button');
          archive.className = 'danger';
          archive.type = 'button';
          archive.textContent = album.archived ? 'Ripristina' : 'Archivia';
          archive.onclick = async () => {
            await api(`/api/albums/${album.id}`, {
              method: 'PATCH',
              json: { archived: !album.archived },
            });
            await loadAlbums();
          };

          actions.append(photosBtn, rename, archive);
          row.append(actions);
          block.append(row);

          const photosPanel = document.createElement('div');
          photosPanel.className = 'photos-panel hidden';
          photosPanel.dataset.panel = album.id;
          block.append(photosPanel);

          root.append(block);

          if (!album.archived) {
            const opt = document.createElement('option');
            opt.value = album.id;
            opt.textContent = `${album.name.en} (${album.slug})`;
            select.append(opt);
          }
        }
      }

      async function toggleAlbumPhotos(albumId, block) {
        const panel = block.querySelector('.photos-panel');
        if (!panel.classList.contains('hidden') && panel.dataset.loaded === '1') {
          panel.classList.add('hidden');
          return;
        }
        panel.classList.remove('hidden');
        panel.innerHTML = '<p class="muted">Caricamento foto…</p>';
        const data = await api(`/api/albums/${albumId}`);
        const album = data.album;
        const photos = data.photos || [];
        // Keep album list in sync (coverPhotoId may have changed)
        const idx = state.albums.findIndex((a) => a.id === albumId);
        if (idx >= 0) state.albums[idx] = album;
        renderPhotoGrid(panel, album, photos);
        panel.dataset.loaded = '1';
      }

      function renderPhotoGrid(panel, album, photos) {
        panel.innerHTML = '';
        if (!photos.length) {
          panel.innerHTML = '<p class="empty">Nessuna foto in questo album.</p>';
          return;
        }
        const grid = document.createElement('div');
        grid.className = 'photo-grid';
        for (const photo of photos) {
          const isCover = album.coverPhotoId === photo.id;
          const card = document.createElement('div');
          card.className = 'photo-card' + (isCover ? ' is-cover' : '');
          const img = document.createElement('img');
          img.src = photo.url;
          img.alt = '';
          img.loading = 'lazy';
          card.append(img);

          const coverBtn = document.createElement('button');
          coverBtn.type = 'button';
          coverBtn.className = `cover-star${isCover ? ' is-cover' : ''}`;
          coverBtn.textContent = isCover ? '★' : '☆';
          coverBtn.setAttribute('aria-label', isCover ? 'Rimuovi copertina' : 'Imposta come copertina');
          coverBtn.title = isCover ? 'Rimuovi copertina' : 'Imposta come copertina';
          coverBtn.onclick = async () => {
            coverBtn.disabled = true;
            try {
              const data = await api(`/api/albums/${album.id}`, {
                method: 'PATCH',
                json: { coverPhotoId: isCover ? null : photo.id },
              });
              const idx = state.albums.findIndex((a) => a.id === album.id);
              if (idx >= 0) state.albums[idx] = data.album;
              renderPhotoGrid(panel, data.album, data.photos || photos);
              // Refresh album row badges without collapsing other panels
              refreshAlbumBadges();
            } catch (e) {
              alert(e.message);
              coverBtn.disabled = false;
            }
          };
          card.append(coverBtn);
          grid.append(card);
        }
        panel.append(grid);
      }

      function refreshAlbumBadges() {
        for (const album of state.albums) {
          const block = document.querySelector(`.album-block[data-album-id="${album.id}"]`);
          if (!block) continue;
          const title = block.querySelector('.album > div');
          if (!title) continue;
          let coverBadge = title.querySelector('.badge.cover');
          if (album.coverPhotoId && !coverBadge) {
            coverBadge = document.createElement('span');
            coverBadge.className = 'badge cover';
            coverBadge.textContent = 'copertina';
            title.insertBefore(coverBadge, title.querySelector('.muted'));
          } else if (!album.coverPhotoId && coverBadge) {
            coverBadge.remove();
          }
        }
      }

      function escapeHtml(s) {
        return String(s)
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;');
      }

      async function loadAlbums() {
        const data = await api('/api/albums?all=1');
        state.albums = data.albums || [];
        $('mode').innerHTML = data.mock
          ? '<span class="badge mock">mock storage</span> R2 unbound; in-memory seed albums.'
          : '<span class="badge">R2</span> PHOTOS_BUCKET connected.';
        renderAlbums();
      }

      async function unlock() {
        const token = $('token').value.trim() || state.token;
        if (!token) {
          alert('Enter ADMIN_TOKEN');
          return;
        }
        await api('/api/auth', { method: 'POST', json: { token } });
        state.token = token;
        localStorage.setItem('admin_token', token);
        $('login').classList.add('hidden');
        $('app').classList.remove('hidden');
        await loadAlbums();
      }

      /** Resize longest edge to maxDim and encode WebP in the browser. */
      async function toWebp(file, maxDim = 2400, quality = 0.82) {
        const bitmap = await createImageBitmap(file);
        const scale = Math.min(1, maxDim / Math.max(bitmap.width, bitmap.height));
        const width = Math.round(bitmap.width * scale);
        const height = Math.round(bitmap.height * scale);
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(bitmap, 0, 0, width, height);
        bitmap.close();
        const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/webp', quality));
        if (!blob) throw new Error('WebP encode failed');
        return { blob, width, height };
      }

      function setUploading(busy) {
        drop.setAttribute('aria-busy', busy ? 'true' : 'false');
        fileInput.disabled = busy;
        $('createAlbum').disabled = busy;
      }

      async function uploadFiles(fileList) {
        const albumId = $('albumSelect').value;
        if (!albumId) {
          status('Seleziona prima un album.');
          return;
        }
        const files = [...fileList].filter((f) => f.type.startsWith('image/'));
        if (!files.length) {
          status('Nessuna immagine selezionata.');
          return;
        }
        setUploading(true);
        try {
          for (let i = 0; i < files.length; i++) {
            const file = files[i];
            status(`Processing ${i + 1}/${files.length}: ${file.name}`);
            const { blob, width, height } = await toWebp(file);
            status(`Uploading ${i + 1}/${files.length}: ${file.name}`);
            const form = new FormData();
            form.append('albumId', albumId);
            form.append('width', String(width));
            form.append('height', String(height));
            form.append('file', blob, file.name.replace(/\.\w+$/, '') + '.webp');
            const headers = {};
            if (state.token) headers.Authorization = `Bearer ${state.token}`;
            const res = await fetch('/api/upload', { method: 'POST', body: form, headers, credentials: 'same-origin' });
            if (!res.ok) {
              const err = await res.json().catch(() => ({}));
              throw new Error(err.error || res.statusText);
            }
          }
          status(`Caricate ${files.length} immagini.`);
        } finally {
          setUploading(false);
          fileInput.value = '';
        }
      }

      $('loginBtn').onclick = () => unlock().catch((e) => alert(e.message));
      $('createAlbum').onclick = async () => {
        try {
          await api('/api/albums', {
            method: 'POST',
            json: {
              nameIt: $('nameIt').value.trim(),
              nameEn: $('nameEn').value.trim(),
              descriptionIt: $('descIt').value.trim(),
              descriptionEn: $('descEn').value.trim(),
            },
          });
          $('nameIt').value = '';
          $('nameEn').value = '';
          $('descIt').value = '';
          $('descEn').value = '';
          await loadAlbums();
        } catch (e) {
          alert(e.message);
        }
      };
      $('refresh').onclick = () => loadAlbums().catch((e) => alert(e.message));
      $('logout').onclick = async () => {
        localStorage.removeItem('admin_token');
        state.token = '';
        try {
          await fetch('/api/auth', { method: 'DELETE', credentials: 'same-origin' });
        } catch (_) {}
        location.reload();
      };

      const drop = $('drop');
      const fileInput = $('fileInput');
      drop.onclick = () => { if (!fileInput.disabled) fileInput.click(); };
      drop.onkeydown = (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (!fileInput.disabled) fileInput.click();
        }
      };
      fileInput.onchange = () => uploadFiles(fileInput.files).catch((e) => status(e.message));
      drop.ondragover = (e) => { e.preventDefault(); drop.classList.add('drag'); };
      drop.ondragleave = () => drop.classList.remove('drag');
      drop.ondrop = (e) => {
        e.preventDefault();
        drop.classList.remove('drag');
        uploadFiles(e.dataTransfer.files).catch((err) => status(err.message));
      };

      if (state.token) {
        unlock().catch(() => {
          $('login').classList.remove('hidden');
          $('app').classList.add('hidden');
        });
      }
    </script>
  </body>
</html>
