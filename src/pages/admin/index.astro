---
export const prerender = false;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin | TCDev</title>
    <link rel="icon" href="/favicon.ico" />
    <style>
      :root {
        color-scheme: dark;
        --ink: #0c0d10;
        --panel: #14161c;
        --line: #2a2f3a;
        --text: #e8ebf2;
        --mute: #8b93a7;
        --accent: #7dd3c0;
        --danger: #f07178;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, sans-serif;
        background: var(--ink);
        color: var(--text);
        min-height: 100dvh;
      }
      header, main { max-width: 960px; margin: 0 auto; padding: 1.25rem; }
      h1 { font-size: 1.5rem; margin: 0; }
      .muted { color: var(--mute); font-size: 0.9rem; }
      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1rem;
        margin-top: 1rem;
      }
      label { display: block; font-size: 0.8rem; color: var(--mute); margin-bottom: 0.35rem; }
      input, textarea, select, button {
        font: inherit;
        color: var(--text);
        background: #1b1e27;
        border: 1px solid var(--line);
        border-radius: 0.75rem;
        padding: 0.65rem 0.8rem;
        width: 100%;
      }
      button {
        cursor: pointer;
        background: var(--accent);
        color: #0c0d10;
        font-weight: 600;
        border: none;
        width: auto;
      }
      button.ghost { background: transparent; color: var(--text); border: 1px solid var(--line); }
      button.danger { background: var(--danger); color: #111; }
      .row { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
      .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
      .drop {
        border: 1.5px dashed var(--line);
        border-radius: 1rem;
        padding: 2rem 1rem;
        text-align: center;
        color: var(--mute);
        margin-top: 0.75rem;
      }
      .drop.drag { border-color: var(--accent); color: var(--accent); }
      .album {
        display: flex; justify-content: space-between; gap: 1rem; align-items: start;
        border-top: 1px solid var(--line); padding: 0.85rem 0;
      }
      .album:first-child { border-top: none; }
      .badge {
        display: inline-block; font-size: 0.7rem; text-transform: uppercase;
        letter-spacing: 0.06em; padding: 0.15rem 0.5rem; border-radius: 999px;
        background: #1b1e27; color: var(--mute); border: 1px solid var(--line);
      }
      .badge.mock { color: #f0b27a; border-color: #5a4630; }
      .hidden { display: none; }
      #status { min-height: 1.25rem; font-size: 0.85rem; color: var(--mute); margin-top: 0.5rem; }
      :focus { outline: none; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      button:disabled { opacity: 0.55; cursor: not-allowed; }
      button[aria-busy="true"] { position: relative; }
      .empty { color: var(--mute); font-size: 0.9rem; padding: 0.5rem 0; }

      .badge.cover { color: var(--accent); border-color: var(--accent); }
      .album-block { border-top: 1px solid var(--line); padding: 0.85rem 0; }
      .album-block:first-child { border-top: none; }
      .photo-grid {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 0.75rem;
      }
      @media (min-width: 640px) {
        .photo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }
      @media (min-width: 1024px) {
        .photo-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      }
      @media (min-width: 1280px) {
        .photo-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      }
      .photo-card {
        position: relative; min-width: 0; overflow: hidden;
        background: #1b1e27; border: 1px solid var(--line); border-radius: 1rem;
      }
      .photo-card.is-cover { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
      .photo-card img {
        display: block; width: 100%; max-width: 100%; height: auto; object-fit: cover;
      }
      .photo-card .cover-star {
        position: absolute; top: 0.625rem; right: 0.625rem; z-index: 1;
        display: grid; place-items: center; width: 2.5rem; height: 2.5rem;
        padding: 0; border: 1px solid var(--line); border-radius: 999px;
        background: rgb(12 13 16 / 78%); color: var(--text);
        font-size: 1.5rem; line-height: 1;
      }
      .photo-card .cover-star.is-cover {
        border-color: var(--accent); background: var(--accent); color: #0c0d10;
      }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }
    </style>
  </head>
  <body>
    <header>
      <h1>Portfolio admin</h1>
      <p class="muted">Albums CRUD + drag-and-drop upload (client resize to WebP).</p>
      <p id="mode" class="muted"></p>
    </header>
    <main>
      <section id="login" class="card">
        <label for="token">Admin token</label>
        <div class="row">
          <input id="token" type="password" autocomplete="current-password" placeholder="ADMIN_TOKEN" />
          <button id="loginBtn" type="button">Unlock</button>
        </div>
      </section>

      <section id="app" class="hidden">
        <div class="card">
          <h2 style="margin:0 0 0.75rem;font-size:1.1rem">Create album</h2>
          <div class="row">
            <div>
              <label for="nameIt">Name IT</label>
              <input id="nameIt" placeholder="Paesaggi / natura" />
            </div>
            <div>
              <label for="nameEn">Name EN</label>
              <input id="nameEn" placeholder="Landscapes / nature" />
            </div>
          </div>
          <div class="row" style="margin-top:0.75rem">
            <div>
              <label for="descIt">Description IT</label>
              <input id="descIt" />
            </div>
            <div>
              <label for="descEn">Description EN</label>
              <input id="descEn" />
            </div>
          </div>
          <div class="actions">
            <button id="createAlbum" type="button">Create</button>
            <button id="refresh" class="ghost" type="button">Refresh</button>
            <button id="logout" class="ghost" type="button">Lock</button>
          </div>
        </div>

        <div class="card">
          <h2 style="margin:0 0 0.75rem;font-size:1.1rem">Albums</h2>
          <div id="albums"></div>
        </div>

        <div class="card">
          <h2 style="margin:0 0 0.75rem;font-size:1.1rem">Upload</h2>
          <label for="albumSelect">Target album</label>
          <select id="albumSelect"></select>
          <div id="drop" class="drop" role="button" tabindex="0" aria-controls="fileInput">Drop images here or click to choose</div>
          <input id="fileInput" type="file" accept="image/*" multiple hidden />
          <p id="status" role="status" aria-live="polite"></p>
        </div>
      </section>
    </main>

    <script is:inline>
      const state = { token: localStorage.getItem('admin_token') || '', albums: [] };

      const $ = (id) => document.getElementById(id);
      const status = (msg) => { $('status').textContent = msg || ''; };

      async function api(path, options = {}) {
        const headers = new Headers(options.headers || {});
        if (state.token) headers.set('Authorization', `Bearer ${state.token}`);
        if (options.json) {
          headers.set('Content-Type', 'application/json');
          options.body = JSON.stringify(options.json);
          delete options.json;
        }
        const res = await fetch(path, { ...options, headers, credentials: 'same-origin' });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || res.statusText);
        return data;
      }


      function renderAlbums() {
        const root = $('albums');
        const select = $('albumSelect');
        root.innerHTML = '';
        select.innerHTML = '';
        if (!state.albums.length) {
          root.innerHTML = '<p class="empty">Nessun album. Creane uno sopra.</p>';
          return;
        }
        for (const album of state.albums) {
          const block = document.createElement('div');
          block.className = 'album-block';
          block.dataset.albumId = album.id;

          const row = document.createElement('div');
          row.className = 'album';
          row.style.borderTop = 'none';
          row.style.padding = '0';
          row.innerHTML = `
            <div>
              <strong>${escapeHtml(album.name.en)}</strong>
              <span class="badge">${escapeHtml(album.slug)}</span>
              ${album.archived ? '<span class="badge">archived</span>' : ''}
              ${album.coverPhotoId ? '<span class="badge cover">copertina</span>' : ''}
              <div class="muted">${escapeHtml(album.name.it)}</div>
            </div>
          `;
          const actions = document.createElement('div');
          actions.className = 'actions';

          const photosBtn = document.createElement('button');
          photosBtn.className = 'ghost';
          photosBtn.type = 'button';
          photosBtn.textContent = 'Foto';
          photosBtn.onclick = () => toggleAlbumPhotos(album.id, block).catch((e) => alert(e.message));

          const rename = document.createElement('button');
          rename.className = 'ghost';
          rename.type = 'button';
          rename.textContent = 'Rename';
          rename.onclick = async () => {
            const nameEn = prompt('Name EN', album.name.en);
            const nameIt = prompt('Name IT', album.name.it);
            if (!nameEn || !nameIt) return;
            await api(`/api/albums/${album.id}`, { method: 'PATCH', json: { nameEn, nameIt } });
            await loadAlbums();
          };

          const archive = document.createElement('button');
          archive.className = 'danger';
          archive.type = 'button';
          archive.textContent = album.archived ? 'Unarchive' : 'Archive';
          archive.onclick = async () => {
            await api(`/api/albums/${album.id}`, {
              method: 'PATCH',
              json: { archived: !album.archived },
            });
            await loadAlbums();
          };

          actions.append(photosBtn, rename, archive);
          row.append(actions);
          block.append(row);

          const photosPanel = document.createElement('div');
          photosPanel.className = 'photos-panel hidden';
          photosPanel.dataset.panel = album.id;
          block.append(photosPanel);

          root.append(block);

          if (!album.archived) {
            const opt = document.createElement('option');
            opt.value = album.id;
            opt.textContent = `${album.name.en} (${album.slug})`;
            select.append(opt);
          }
        }
      }

      async function toggleAlbumPhotos(albumId, block) {
        const panel = block.querySelector('.photos-panel');
        if (!panel.classList.contains('hidden') && panel.dataset.loaded === '1') {
          panel.classList.add('hidden');
          return;
        }
        panel.classList.remove('hidden');
        panel.innerHTML = '<p class="muted">Caricamento foto…</p>';
        const data = await api(`/api/albums/${albumId}`);
        const album = data.album;
        const photos = data.photos || [];
        // Keep album list in sync (coverPhotoId may have changed)
        const idx = state.albums.findIndex((a) => a.id === albumId);
        if (idx >= 0) state.albums[idx] = album;
        renderPhotoGrid(panel, album, photos);
        panel.dataset.loaded = '1';
      }

      function renderPhotoGrid(panel, album, photos) {
        panel.innerHTML = '';
        if (!photos.length) {
          panel.innerHTML = '<p class="empty">Nessuna foto in questo album.</p>';
          return;
        }
        const grid = document.createElement('div');
        grid.className = 'photo-grid';
        for (const photo of photos) {
          const isCover = album.coverPhotoId === photo.id;
          const card = document.createElement('div');
          card.className = 'photo-card' + (isCover ? ' is-cover' : '');
          const img = document.createElement('img');
          img.src = photo.url;
          img.alt = '';
          img.loading = 'lazy';
          card.append(img);

          const coverBtn = document.createElement('button');
          coverBtn.type = 'button';
          coverBtn.className = `cover-star${isCover ? ' is-cover' : ''}`;
          coverBtn.textContent = isCover ? '★' : '☆';
          coverBtn.setAttribute('aria-label', isCover ? 'Rimuovi copertina' : 'Imposta come copertina');
          coverBtn.title = isCover ? 'Rimuovi copertina' : 'Imposta come copertina';
          coverBtn.onclick = async () => {
            coverBtn.disabled = true;
            try {
              const data = await api(`/api/albums/${album.id}`, {
                method: 'PATCH',
                json: { coverPhotoId: isCover ? null : photo.id },
              });
              const idx = state.albums.findIndex((a) => a.id === album.id);
              if (idx >= 0) state.albums[idx] = data.album;
              renderPhotoGrid(panel, data.album, data.photos || photos);
              // Refresh album row badges without collapsing other panels
              refreshAlbumBadges();
            } catch (e) {
              alert(e.message);
              coverBtn.disabled = false;
            }
          };
          card.append(coverBtn);
          grid.append(card);
        }
        panel.append(grid);
      }

      function refreshAlbumBadges() {
        for (const album of state.albums) {
          const block = document.querySelector(`.album-block[data-album-id="${album.id}"]`);
          if (!block) continue;
          const title = block.querySelector('.album > div');
          if (!title) continue;
          let coverBadge = title.querySelector('.badge.cover');
          if (album.coverPhotoId && !coverBadge) {
            coverBadge = document.createElement('span');
            coverBadge.className = 'badge cover';
            coverBadge.textContent = 'copertina';
            title.insertBefore(coverBadge, title.querySelector('.muted'));
          } else if (!album.coverPhotoId && coverBadge) {
            coverBadge.remove();
          }
        }
      }

      function escapeHtml(s) {
        return String(s)
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;');
      }

      async function loadAlbums() {
        const data = await api('/api/albums?all=1');
        state.albums = data.albums || [];
        $('mode').innerHTML = data.mock
          ? '<span class="badge mock">mock storage</span> R2 unbound; in-memory seed albums.'
          : '<span class="badge">R2</span> PHOTOS_BUCKET connected.';
        renderAlbums();
      }

      async function unlock() {
        const token = $('token').value.trim() || state.token;
        if (!token) {
          alert('Enter ADMIN_TOKEN');
          return;
        }
        await api('/api/auth', { method: 'POST', json: { token } });
        state.token = token;
        localStorage.setItem('admin_token', token);
        $('login').classList.add('hidden');
        $('app').classList.remove('hidden');
        await loadAlbums();
      }

      /** Resize longest edge to maxDim and encode WebP in the browser. */
      async function toWebp(file, maxDim = 2400, quality = 0.82) {
        const bitmap = await createImageBitmap(file);
        const scale = Math.min(1, maxDim / Math.max(bitmap.width, bitmap.height));
        const width = Math.round(bitmap.width * scale);
        const height = Math.round(bitmap.height * scale);
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(bitmap, 0, 0, width, height);
        bitmap.close();
        const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/webp', quality));
        if (!blob) throw new Error('WebP encode failed');
        return { blob, width, height };
      }

      function setUploading(busy) {
        drop.setAttribute('aria-busy', busy ? 'true' : 'false');
        fileInput.disabled = busy;
        $('createAlbum').disabled = busy;
      }

      async function uploadFiles(fileList) {
        const albumId = $('albumSelect').value;
        if (!albumId) {
          status('Select an album first.');
          return;
        }
        const files = [...fileList].filter((f) => f.type.startsWith('image/'));
        if (!files.length) {
          status('No image files selected.');
          return;
        }
        setUploading(true);
        try {
          for (let i = 0; i < files.length; i++) {
            const file = files[i];
            status(`Processing ${i + 1}/${files.length}: ${file.name}`);
            const { blob, width, height } = await toWebp(file);
            status(`Uploading ${i + 1}/${files.length}: ${file.name}`);
            const form = new FormData();
            form.append('albumId', albumId);
            form.append('width', String(width));
            form.append('height', String(height));
            form.append('file', blob, file.name.replace(/\.\w+$/, '') + '.webp');
            const headers = {};
            if (state.token) headers.Authorization = `Bearer ${state.token}`;
            const res = await fetch('/api/upload', { method: 'POST', body: form, headers, credentials: 'same-origin' });
            if (!res.ok) {
              const err = await res.json().catch(() => ({}));
              throw new Error(err.error || res.statusText);
            }
          }
          status(`Uploaded ${files.length} image(s).`);
        } finally {
          setUploading(false);
          fileInput.value = '';
        }
      }

      $('loginBtn').onclick = () => unlock().catch((e) => alert(e.message));
      $('createAlbum').onclick = async () => {
        try {
          await api('/api/albums', {
            method: 'POST',
            json: {
              nameIt: $('nameIt').value.trim(),
              nameEn: $('nameEn').value.trim(),
              descriptionIt: $('descIt').value.trim(),
              descriptionEn: $('descEn').value.trim(),
            },
          });
          $('nameIt').value = '';
          $('nameEn').value = '';
          $('descIt').value = '';
          $('descEn').value = '';
          await loadAlbums();
        } catch (e) {
          alert(e.message);
        }
      };
      $('refresh').onclick = () => loadAlbums().catch((e) => alert(e.message));
      $('logout').onclick = async () => {
        localStorage.removeItem('admin_token');
        state.token = '';
        try {
          await fetch('/api/auth', { method: 'DELETE', credentials: 'same-origin' });
        } catch (_) {}
        location.reload();
      };

      const drop = $('drop');
      const fileInput = $('fileInput');
      drop.onclick = () => { if (!fileInput.disabled) fileInput.click(); };
      drop.onkeydown = (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (!fileInput.disabled) fileInput.click();
        }
      };
      fileInput.onchange = () => uploadFiles(fileInput.files).catch((e) => status(e.message));
      drop.ondragover = (e) => { e.preventDefault(); drop.classList.add('drag'); };
      drop.ondragleave = () => drop.classList.remove('drag');
      drop.ondrop = (e) => {
        e.preventDefault();
        drop.classList.remove('drag');
        uploadFiles(e.dataTransfer.files).catch((err) => status(err.message));
      };

      if (state.token) {
        unlock().catch(() => {
          $('login').classList.remove('hidden');
          $('app').classList.add('hidden');
        });
      }
    </script>
  </body>
</html>
