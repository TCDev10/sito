---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, type Locale } from '../../data/site';
import { isLocale, localizedPath } from '../../i18n';
import { t } from '../../i18n/ui';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { lang: 'it' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang!;
if (!isLocale(lang)) {
  return Astro.rewrite('/404');
}
const locale = lang as Locale;

const contacts = [
  { label: t(locale, 'contact.email'), href: SITE.social.email, value: SITE.email },
  { label: 'Instagram', href: SITE.social.instagram, value: 'TCDev' },
  { label: 'LinkedIn', href: SITE.social.linkedin, value: 'tcdev0' },
  { label: 'GitHub', href: SITE.social.github, value: 'TCDev10' },
];

const breadcrumbs = [
  { name: t(locale, 'nav.home'), path: '/' },
  { name: t(locale, 'contact.title'), path: '/contact' },
];
---

<BaseLayout
  locale={locale}
  title={t(locale, 'seo.contact.title')}
  description={t(locale, 'seo.contact.desc')}
  path="/contact"
  breadcrumbs={breadcrumbs}
>
  <header class="page-header">
    <p class="eyebrow">{t(locale, 'nav.contact')} · Bergamo</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight">{t(locale, 'contact.title')}</h1>
    <p class="prose-muted mt-4">{t(locale, 'contact.subtitle')}</p>
  </header>

  <ul class="mt-12 grid gap-4 sm:grid-cols-2">
    {
      contacts.map((c) => (
        <li>
          <a
            class="card-interactive block p-5"
            href={c.href}
            rel={c.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
          >
            <p class="text-xs uppercase tracking-wider text-mute">{c.label}</p>
            <p class="mt-2 font-display text-lg font-semibold">{c.value}</p>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="prose-muted mt-10 text-sm">
    <a class="text-accent hover:underline" href={localizedPath(locale, '/about')}>{t(locale, 'nav.about')}</a>
    {' · '}
    <a class="text-accent hover:underline" href={localizedPath(locale, '/projects')}>{t(locale, 'nav.projects')}</a>
    {' · '}
    <a class="text-accent hover:underline" href={localizedPath(locale, '/photos')}>{t(locale, 'nav.photos')}</a>
  </p>
</BaseLayout>
