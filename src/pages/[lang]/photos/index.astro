---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AlbumCard from '../../../components/AlbumCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { isLocale, localizedPath } from '../../../i18n';
import { t } from '../../../i18n/ui';
import { listAlbums, listPhotos } from '../../../lib/storage';
import type { Locale } from '../../../data/site';

export const prerender = false;

const lang = Astro.params.lang!;
if (!isLocale(lang)) {
  return Astro.rewrite('/404');
}
const locale = lang as Locale;
const albums = await listAlbums(Astro.locals);
const albumMeta = await Promise.all(
  albums.map(async (album) => {
    const photos = await listPhotos(album.id, Astro.locals);
    return {
      album,
      count: photos.length,
      coverUrl: photos[0]?.url,
    };
  }),
);
---

<BaseLayout
  locale={locale}
  title={t(locale, 'seo.photos.title')}
  description={t(locale, 'seo.photos.desc')}
  path="/photos"
>
  <header class="page-header">
    <p class="eyebrow">{t(locale, 'nav.photo')}</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight">{t(locale, 'photos.title')}</h1>
    <p class="prose-muted mt-4">{t(locale, 'photos.subtitle')}</p>
  </header>

  {
    albumMeta.length === 0 ? (
      <div class="mt-12">
        <EmptyState
          title={t(locale, 'photos.empty.list.title')}
          body={t(locale, 'photos.empty.list.body')}
          actionHref={localizedPath(locale, '/projects')}
          actionLabel={t(locale, 'home.cta.projects')}
        />
      </div>
    ) : (
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {albumMeta.map(({ album, count, coverUrl }) => (
          <AlbumCard album={album} locale={locale} count={count} coverUrl={coverUrl} />
        ))}
      </div>
    )
  }
</BaseLayout>
