---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { isLocale, localizedPath } from '../../i18n';
import { t } from '../../i18n/ui';
import { comingSoonProjects, publicProjects } from '../../data/projects';
import type { Locale } from '../../data/site';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { lang: 'it' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang!;
if (!isLocale(lang)) {
  return Astro.rewrite('/404');
}
const locale = lang as Locale;
const breadcrumbs = [
  { name: t(locale, 'nav.home'), path: '/' },
  { name: t(locale, 'projects.title'), path: '/projects' },
];
---

<BaseLayout
  locale={locale}
  title={t(locale, 'seo.projects.title')}
  description={t(locale, 'seo.projects.desc')}
  path="/projects"
  breadcrumbs={breadcrumbs}
>
  <header class="page-header">
    <p class="eyebrow">{t(locale, 'nav.dev')} · Bergamo</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight">{t(locale, 'projects.title')}</h1>
    <p class="prose-muted mt-4">{t(locale, 'projects.subtitle')}</p>
  </header>

  <section class="section-gap !mt-12">
    <h2 class="mb-5 font-display text-xl font-semibold">{t(locale, 'projects.public')}</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {publicProjects().map((project) => <ProjectCard project={project} locale={locale} />)}
    </div>
  </section>

  <section class="section-gap">
    <h2 class="mb-5 font-display text-xl font-semibold">{t(locale, 'projects.soon')}</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {comingSoonProjects().map((project) => <ProjectCard project={project} locale={locale} />)}
    </div>
  </section>

  <aside class="section-gap panel p-6">
    <p class="prose-muted text-sm sm:text-base">{t(locale, 'projects.cross')}</p>
    <a class="mt-3 inline-block text-sm font-medium text-accent hover:underline" href={localizedPath(locale, '/photos')}>
      {t(locale, 'projects.cross.cta')}
    </a>
  </aside>
</BaseLayout>
