# Copy to .env for local overrides. Never commit real secrets.

# ── Site ──────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://tcdev.xyz

# ── Admin auth (required in production) ───────────────────────────────────────
# Protects /admin UI and all /api/* mutating routes.
# Send as: Authorization: Bearer <token>  or  cookie admin_token=<token>
ADMIN_TOKEN=change-me-to-a-long-random-string

# ── Cloudflare R2 (set in Pages/Workers dashboard, not usually in .env) ───────
# Binding name expected by the app: PHOTOS_BUCKET
# Objects layout:
#   albums.json                          # album metadata array
#   albums/{albumId}/{photoId}.webp      # photo binaries
#   albums/{albumId}/{photoId}.json      # optional per-photo meta
#
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=tcdev-photos
# R2_PUBLIC_URL=https://photos.tcdev.xyz

# ── Local / build mock ────────────────────────────────────────────────────────
# When PHOTOS_BUCKET is unbound, album CRUD uses in-memory mock storage
# seeded with Paesaggi, Ritratti, Eventi. Fine for `npm run build` + local UI.
